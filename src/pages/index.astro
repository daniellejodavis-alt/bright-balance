---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Bright Balance Bookkeeping</title>

    <style>
      :root {
        --deep: #23352F;
        --moss: #5E7465;
        --blue: #3E4A57;
        --sand: #F3E8D9;
        --gold: #C49A4A;
      }

      body {
        margin: 0;
        font-family: Georgia, serif;
        background: var(--sand);
        color: var(--deep);
      }

      .hero {
        height: 100vh;
        background:
          linear-gradient(rgba(35,53,47,.45), rgba(35,53,47,.45)),
          url('/hero-banner.jpg');

        background-size: cover;
        background-position: center;

        display: flex;
        align-items: center;
        justify-content: center;

        text-align: center;
        color: white;
      }

      .hero-content {
        max-width: 700px;
        padding: 2rem;
      }

      h1 {
        font-size: 4rem;
        margin-bottom: 1rem;
      }

      p {
        line-height: 1.7;
      }

      .button {
        display: inline-block;
        margin-top: 2rem;
        padding: 14px 28px;

        background: var(--gold);
        color: white;

        text-decoration: none;
        border-radius: 10px;
      }

      .section {
        padding: 5rem 2rem;
        max-width: 1100px;
        margin: auto;
      }

      .services {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(250px,1fr));
        gap: 2rem;
      }

      .card {
        background: white;
        padding: 2rem;
        border-radius: 16px;
      }
    </style>
  </head>

  <body>

    <section class="hero">
      <div class="hero-content">
        <h1>Bright Balance</h1>

        <p>
          Calm, reliable bookkeeping support for small businesses and local owners.
        </p>

        <a href="#services" class="button">
          Schedule a Consultation
        </a>
      </div>
    </section>

    <section class="section" id="services">
      <h2>Services</h2>

      <div class="services">

        <div class="card">
          <h3>Monthly Bookkeeping</h3>
          <p>
            Accurate categorization, reconciliations, and organized records.
          </p>
        </div>

        <div class="card">
          <h3>Payroll Support</h3>
          <p>
            Payroll processing assistance and documentation management.
          </p>
        </div>

        <div class="card">
          <h3>Financial Reporting</h3>
          <p>
            Clear financial reports to support informed decisions.
          </p>
        </div>

      </div>
    </section>

  </body>
</html>
